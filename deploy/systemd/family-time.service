# Starts the stack at boot with the image update.sh last deployed.
# Install: see docs/setup/server.md.
[Unit]
Description=Family time stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/family-time
# Through the same compose() as update.sh (scripts/stack.sh), so the deploy state (the LAN
# address, the ledger choice, which AdGuard, ADR 0022) is read and checked the same way, and the
# bundled AdGuard starts only when it was chosen.
ExecStart=/bin/bash /opt/family-time/scripts/stack.sh up
ExecStop=/bin/bash /opt/family-time/scripts/stack.sh stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
