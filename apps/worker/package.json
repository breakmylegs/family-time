{
  "name": "@family-time/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reconcile": {
      "types": "./dist/reconcile.d.ts",
      "default": "./dist/reconcile.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts"
  },
  "dependencies": {
    "@family-time/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "@family-time/adguard-client": "workspace:*",
    "@family-time/domain": "workspace:*",
    "@family-time/notify": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/pg": "8.23.1"
  }
}
