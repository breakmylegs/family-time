{
  "name": "@family-time/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "dev": "tsx dev/server.ts"
  },
  "dependencies": {
    "@family-time/adguard-client": "workspace:*",
    "@family-time/ai": "workspace:*",
    "@family-time/db": "workspace:*",
    "@family-time/domain": "workspace:*",
    "@family-time/ledger": "workspace:*",
    "@family-time/notify": "workspace:*",
    "@family-time/schemas": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@family-time/worker": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
