{
  "name": "family-time",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:deploy": "bash scripts/test/verify-deploy.sh",
    "test:ops": "bash scripts/test/verify-ops.sh",
    "gate:full": "node scripts/gate.mjs --with-deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
